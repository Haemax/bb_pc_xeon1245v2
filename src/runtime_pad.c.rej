+            else if (!strncmp(line,"mouse_sensitivity=",18))
+                mouse_sensitivity_x=mouse_sensitivity_y=
+                    mouse_float_in_range(value,0.05f,20.0f,mouse_sensitivity_x);
+            else if (!strncmp(line,"mouse_sensitivity_x=",20))
+                mouse_sensitivity_x=mouse_float_in_range(value,0.05f,20.0f,mouse_sensitivity_x);
+            else if (!strncmp(line,"mouse_sensitivity_y=",20))
+                mouse_sensitivity_y=mouse_float_in_range(value,0.05f,20.0f,mouse_sensitivity_y);
+            else if (!strncmp(line,"mouse_smoothing=",16))
+                mouse_smoothing=mouse_float_in_range(value,0.0f,0.95f,mouse_smoothing);
             continue;
         }
         if ((!keyboard && !pad) || !eq) continue;
@@ -402,6 +431,7 @@ static void load_bindings(void) {
