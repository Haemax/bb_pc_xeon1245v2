 /* Mouse look (bbport.ini): mouse_look=0 leaves the mouse alone; mouse_sensitivity (default 1:
- * ~1000 pixels/s turn the camera at full speed), mouse_invert_y=1. */
-static int mouse_look=1, mouse_invert_y;
-static float mouse_sensitivity=1.0f;
+ * ~1000 pixels/s turn the camera at full speed) sets both axes, mouse_sensitivity_x / _y one axis
+ * (later lines win); mouse_invert_x=1, mouse_invert_y=1; mouse_smoothing=0..0.95 (default 0: raw)
+ * filters the motion over a few frames (the strength is per 1/60 s, so it feels the same at any
+ * frame rate). The same names in capitals with BB_ in front (BB_MOUSE_SENSITIVITY_X, ...) in the
+ * environment override the file. */
+static int mouse_look=1, mouse_invert_x, mouse_invert_y;
+static float mouse_sensitivity_x=1.0f, mouse_sensitivity_y=1.0f, mouse_smoothing;
+static float mouse_float_in_range(const char *text, float low, float high, float fallback) {
+    char *end=NULL;
+    const float v=strtof(text,&end);
+    return end!=text && v>=low && v<=high ? v : fallback;
+}
+static void mouse_env_overrides(void) {
+    const char *v;
+    if ((v=getenv("BB_MOUSE_SENSITIVITY")) && *v)
+        mouse_sensitivity_x=mouse_sensitivity_y=mouse_float_in_range(v,0.05f,20.0f,mouse_sensitivity_x);
+    if ((v=getenv("BB_MOUSE_SENSITIVITY_X")) && *v)
+        mouse_sensitivity_x=mouse_float_in_range(v,0.05f,20.0f,mouse_sensitivity_x);
+    if ((v=getenv("BB_MOUSE_SENSITIVITY_Y")) && *v)
+        mouse_sensitivity_y=mouse_float_in_range(v,0.05f,20.0f,mouse_sensitivity_y);
+    if ((v=getenv("BB_MOUSE_SMOOTHING")) && *v)
+        mouse_smoothing=mouse_float_in_range(v,0.0f,0.95f,mouse_smoothing);
+    if ((v=getenv("BB_MOUSE_INVERT_X")) && *v) mouse_invert_x=atoi(v)!=0;
+    if ((v=getenv("BB_MOUSE_INVERT_Y")) && *v) mouse_invert_y=atoi(v)!=0;
+}
 /* key.<input>= / pad.<input>= lines of the settings file. */
 static void load_bindings(void) {
     bind_defaults();
-    mouse_look=1; mouse_invert_y=0; mouse_sensitivity=1.0f;
+    mouse_look=1; mouse_invert_x=mouse_invert_y=0; mouse_sensitivity_x=mouse_sensitivity_y=1.0f;
+    mouse_smoothing=0.0f;
     const char *path=getenv("BB_CONFIG");
     FILE *f=path ? fopen(path,"r") : NULL;
-    if (!f) return;
+    if (!f) { mouse_env_overrides(); return; }
     char line[512];
     while (fgets(line,sizeof line,f)) {
         const int keyboard=!strncmp(line,"key.",4), pad=!strncmp(line,"pad.",4);
@@ -372,11 +395,17 @@ static void load_bindings(void) {
         if (eq && !keyboard && !pad) {
