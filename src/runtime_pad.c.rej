     if (deadzone<0) {
@@ -487,9 +517,14 @@ static void apply_mouse_look(PadData *d, double dx, double dy, uint64_t now, int
         deadzone=env && *env ? atoi(env) : 16;
         if (deadzone<0 || deadzone>100) deadzone=16;
     }
-    const float gain=127.0f/(1000.0f*LOOK_TAU_US/1e6f)*mouse_sensitivity, decay=1.0f-dt/LOOK_TAU_US;
-    look_x=look_x*decay+(float)dx*gain;
-    look_y=look_y*decay+(float)(mouse_invert_y ? -dy : dy)*gain;
+    const float base_gain=127.0f/(1000.0f*LOOK_TAU_US/1e6f), decay=1.0f-dt/LOOK_TAU_US;
+    /* mouse_smoothing: an exponential filter on the motion, its strength per 1/60 s (0: raw). The
+     * filter keeps the total motion, so the camera still turns as far, only a little later. */
+    const float keep=mouse_smoothing>0.0f && dt>0.0f ? SDL_powf(mouse_smoothing,dt/16667.0f) : 0.0f;
+    look_smooth_x=look_smooth_x*keep+(float)(mouse_invert_x ? -dx : dx)*(1.0f-keep);
+    look_smooth_y=look_smooth_y*keep+(float)(mouse_invert_y ? -dy : dy)*(1.0f-keep);
+    look_x=look_x*decay+look_smooth_x*base_gain*mouse_sensitivity_x;
+    look_y=look_y*decay+look_smooth_y*base_gain*mouse_sensitivity_y;
     look_x=look_x<-127 ? -127 : look_x>127 ? 127 : look_x;
     look_y=look_y<-127 ? -127 : look_y>127 ? 127 : look_y;
     d->right_x=look_axis(look_x,d->right_x,deadzone);
